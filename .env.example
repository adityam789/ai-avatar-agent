# Copy to .env and fill in. Never commit .env.

# Web search via Google Custom Search (deprecated; discontinued 2027-01-01)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# LLM access via OpenRouter
OPEN_ROUTER_API_KEY=
# Optional attribution headers sent to OpenRouter
OPEN_ROUTER_REFERER=
OPEN_ROUTER_TITLE=

# Reddit research collector (Reddit API access now requires approval; optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
